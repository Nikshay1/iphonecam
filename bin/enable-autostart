#!/bin/bash
set -euo pipefail
if ! command -v iphonecam >/dev/null; then
  echo 'Install the package with bin/install first.' >&2
  exit 1
fi
target="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/iphonecam.desktop"
mkdir -p "$(dirname "$target")"
if [[ -e $target ]]; then
  cp -a "$target" "$target.backup-$(date +%Y%m%d-%H%M%S)"
fi
install -m644 /usr/share/iphonecam/iphonecam-autostart.desktop "$target"
echo "Tray app will start at login. To undo: rm '$target'"
