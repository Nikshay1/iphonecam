pkgname=iphonecam
pkgver=0.1.0
pkgrel=1
pkgdesc='USB iPhone webcam with Omarchy tray controls and DroidCam lens switching'
arch=('x86_64' 'aarch64')
url='https://github.com/Nikshay1/iphonecam'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'ffmpeg' 'libimobiledevice' 'libusbmuxd' 'usbmuxd' 'v4l2loopback-dkms' 'v4l-utils')
makedepends=('gcc' 'make')
optdepends=('foot: opens the driver setup terminal')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

check() {
  cd "$startdir/.."
  ./bin/test
}

package() {
  cd "$startdir/.."
  install -Dm755 build/iphonecam "$pkgdir/usr/bin/iphonecam"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/iphonecam.desktop "$pkgdir/usr/share/applications/iphonecam.desktop"
  install -Dm644 pkgbuild/iphonecam-autostart.desktop "$pkgdir/usr/share/iphonecam/iphonecam-autostart.desktop"
  for icon in iphonecam iphonecam-on; do
    install -Dm644 "pkgbuild/$icon.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/$icon.svg"
  done
  install -Dm755 bin/setup-system "$pkgdir/usr/share/iphonecam/setup-system"
  install -Dm755 bin/enable-autostart "$pkgdir/usr/share/iphonecam/enable-autostart"
}
